---
import { footerNavigation } from '../config/navigation';
import { cn } from '../lib/utils';
import { uiClasses } from '../config/ui';
import SocialLinks from "./SocialLinks.astro";
---

<footer
    class="relative flex min-h-[400px] flex-col items-center justify-end overflow-x-clip px-8 pb-0"
>
    <nav aria-label="Footer" class="mx-auto mb-12 grid w-full max-w-screen-lg grid-cols-2 gap-8 border-t border-orange-950/10 pt-10 text-sm sm:mb-16 sm:grid-cols-3">
        {footerNavigation.map((group) => <div><p class="mb-4 font-semibold text-stone-800">{group.label}</p><ul class="space-y-3">{group.links.map((link) => <li><a class={cn(uiClasses.focusRing, 'rounded-sm text-stone-600 hover:text-stone-900 hover:underline')} href={link.href}>{link.label}</a></li>)}</ul></div>)}
    </nav>
    <div class="mb-3 sm:mb-4">
        <SocialLinks />
    </div>
    <div
        class="pointer-events-none -mt-6 -mb-[0.12em] select-none text-[5rem] leading-none font-black animate-fade-in whitespace-nowrap sm:text-[7rem] md:text-[12rem] lg:text-[14rem]"
        style="background-image: linear-gradient(to bottom, rgba(234, 88, 12, 0.28), rgba(194, 65, 12, 0.08)); -webkit-background-clip: text; background-clip: text; color: transparent;"
    >
        VIBE HUD
    </div>
</footer>
