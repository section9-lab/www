---
import FeatureIllustration from './features/FeatureIllustration.astro'
import { featureItems } from '../config/features'
---
<section id="feature-grid" class="isolate mt-16 w-full sm:mt-20">
  <h2 class="sr-only">What vibe hud can do</h2>
  <div class="mx-auto grid w-full max-w-screen-lg gap-x-6 gap-y-12 sm:grid-cols-2 lg:grid-cols-4">
    {featureItems.map((feature) => (
      <article class="flex flex-col items-center text-center">
        <FeatureIllustration id={feature.id} />
        <h3 class="text-2xl font-bold leading-tight">{feature.titleTop}<br />{feature.titleBottom}</h3>
        <p class="mt-3 max-w-60 text-sm leading-relaxed text-stone-500">{feature.description}</p>
      </article>
    ))}
  </div>
</section>
