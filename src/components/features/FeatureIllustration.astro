---
import { Layers3, ShieldCheck, MessagesSquare, Send, Terminal, SlidersHorizontal, RefreshCw, Plug } from 'lucide-react'
import type { FeatureItemId } from '../../config/features'
interface Props { id: FeatureItemId }
const icons = { sessions: Layers3, approvals: ShieldCheck, history: MessagesSquare, replies: Send, terminals: Terminal, preferences: SlidersHorizontal, updates: RefreshCw, hooks: Plug }
const Icon = icons[Astro.props.id]
---
<Icon className="mb-5 size-12 text-stone-700" strokeWidth={1.5} aria-hidden="true" />
