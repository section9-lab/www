---
import { getCollection } from 'astro:content'
import FaqAccordion from './FaqAccordion'
import { FileText } from 'lucide-react'
import { siteConfig } from '../../config/site'
import { uiClasses } from '../../config/ui'

const faqs = (await getCollection('faqs'))
  .sort((a, b) => a.data.order - b.data.order)
  .map((entry) => ({
    id: entry.id,
    title: entry.data.title,
    badge: entry.data.badge,
    notes: entry.data.notes,
    body: entry.body ?? '',
  }))

interface Props { standalone?: boolean }
const { standalone = false } = Astro.props
const Heading = standalone ? 'h1' : 'h2'
const SupportHeading = standalone ? 'h2' : 'h3'
const lastUpdated = 'October 2026'
---

<div class="mb-0 w-full max-w-screen-md sm:mb-6">
  <Heading class="mb-3 text-6xl font-bold sm:text-8xl">FAQs</Heading>

  <div>
    <p class="group dark:text-orange-75/50 flex items-center text-xl text-stone-500">
      <FileText className="mr-2 size-5" aria-hidden="true" />
      <span>Updated {lastUpdated}</span>
    </p>
  </div>

  <FaqAccordion client:idle items={faqs} questionLevel={standalone ? 2 : 3} />

  <div class="mt-12 pt-6">
    <SupportHeading class="mb-3 text-2xl font-bold">Have more questions?</SupportHeading>
    <p class="text-xl">
      For setup help or feedback,
      <a
        class:list={[uiClasses.contactLink, 'ml-1']}
        href={siteConfig.supportUrl}
        target="_blank" rel="noopener noreferrer" aria-label="Open GitHub issues"
      >
        visit GitHub issues
      </a>.
    </p>
    <p class="mt-4 text-lg text-stone-600">For orders or refunds, email <a class={uiClasses.contactLink} href={siteConfig.billingSupportUrl}>{siteConfig.billingSupportEmail}</a>.</p>
  </div>
</div>
