---
import { getCollection } from 'astro:content'
import Layout from '../layouts/Layout.astro'
import AppHeader from '../components/AppHeader.astro'
import AppFooter from '../components/AppFooter.astro'
import FaqsContent from '../components/faq/FaqsContent.astro'
import '../assets/css/main.css'
import { siteConfig } from '../config/site'

const faqs = (await getCollection('faqs')).sort((a, b) => a.data.order - b.data.order)

const stripMarkdown = (value: string) =>
  value
    .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
    .replace(/[*_`>#-]/g, '')
    .replace(/\s+/g, ' ')
    .trim()

const pageUrl = `${siteConfig.siteUrl}/faqs/`
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'VibeHUD FAQs',
    description:
      'Answers to common questions about VibeHUD for Mac, including supported agents, tool approvals, terminal compatibility, installation, updates, and privacy.',
    url: pageUrl,
    isPartOf: {
      '@type': 'WebSite',
      name: siteConfig.siteName,
      url: siteConfig.siteUrl,
    },
    inLanguage: siteConfig.language,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((entry) => ({
      '@type': 'Question',
      name: entry.data.title,
      acceptedAnswer: {
        '@type': 'Answer',
        text: stripMarkdown(entry.body ?? ''),
      },
    })),
  },
]
---
<Layout
  title="vibe hud FAQs | Agents, Approvals, Installation, and Support"
  description="Answers to common questions about VibeHUD for Mac, including supported agents, tool approvals, terminal compatibility, installation, updates, and privacy."
  keywords={[
    'VibeHUD FAQ',
    'VibeHUD support',
    'vibe hud agent compatibility',
    'vibe hud tool approvals',
    'vibe hud installation',
  ]}
  structuredData={structuredData}
>
  <AppHeader />
  <main class="flex flex-1 justify-center px-8 pt-32 pb-16 sm:pt-48 sm:pb-28 xl:px-36">
    <FaqsContent standalone />
  </main>
  <AppFooter />
</Layout>
