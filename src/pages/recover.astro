---
import Layout from '../layouts/Layout.astro'
import AppHeader from '../components/AppHeader.astro'
import AppFooter from '../components/AppFooter.astro'
import { siteConfig } from '../config/site'
import { uiClasses } from '../config/ui'
import '../assets/css/main.css'
---
<Layout title="vibe hud | Installation help" description="Get help installing, updating, or reconnecting vibe hud agent integrations.">
  <AppHeader showDownload={false} />
  <main class="flex flex-1 justify-center px-8 pt-32 pb-16 sm:pt-48 sm:pb-28">
    <section class="w-full max-w-screen-md">
      <h1 class="mb-6 text-5xl font-bold tracking-tight sm:text-7xl">Get back to work.</h1>
      <div class="space-y-6 text-xl leading-relaxed text-stone-600">
        <p>Need a fresh installation? Get the latest release from the <a class={uiClasses.contactLink} href="/download">download page</a>, move VibeHUD.app into Applications, and launch it.</p>
        <p>If sessions are missing, check Agent Hooks in the notch menu and confirm your agent and terminal setup. See the <a class={uiClasses.contactLink} href="/faqs">FAQ page</a> for compatibility details.</p>
        <p>For problems with installation or updates, <a class={uiClasses.contactLink} href={siteConfig.supportUrl} target="_blank" rel="noopener noreferrer">open a GitHub issue</a> with your app version, macOS version, and the steps that reproduce the problem.</p>
      </div>
    </section>
  </main>
  <AppFooter />
</Layout>
