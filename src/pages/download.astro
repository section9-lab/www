---
import { Download as DownloadIcon, CodeXml } from 'lucide-react'
import Layout from '../layouts/Layout.astro'
import AppHeader from '../components/AppHeader.astro'
import AppFooter from '../components/AppFooter.astro'
import { siteConfig } from '../config/site'
import { uiClasses } from '../config/ui'
import '../assets/css/main.css'
const pageUrl = `${siteConfig.siteUrl}/download/`
const description = 'Download vibe hud for macOS 15.6 or later. Follow AI agent sessions, handle tool approvals, and reply from your Mac’s notch.'
const structuredData = {
  '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: siteConfig.siteName,
  applicationCategory: 'DeveloperApplication', operatingSystem: `macOS ${siteConfig.minimumMacOS} or later`,
  downloadUrl: siteConfig.releaseUrl, url: pageUrl, description,
}
---
<Layout title="Download vibe hud for Mac" description={description} structuredData={structuredData}>
  <AppHeader showDownload={false} />
  <main class="flex flex-1 justify-center px-8 pt-32 pb-16 sm:pt-48 sm:pb-28">
    <section class="w-full max-w-screen-md text-center">
      <h1 class="mb-6 text-5xl font-bold tracking-tight sm:text-7xl">Your agents.<br />One notch away.</h1>
      <p class="mx-auto max-w-xl text-xl leading-relaxed text-stone-600">Download vibe hud for Mac to follow sessions, approve tools, and keep conversations moving.</p>
      <div class="mx-auto my-12 flex max-w-sm flex-col items-center rounded-3xl border border-orange-950/10 bg-orange-950/5 px-6 py-8 sm:my-16">
        <img class="mb-4 size-28 object-contain" src="/images/icon.webp" alt="Native vibe hud app icon" width="112" height="112" />
        <h2 class="text-2xl font-bold">{siteConfig.siteName}</h2>
        <p class="mt-2 text-sm text-stone-500">Requires macOS {siteConfig.minimumMacOS} or later</p>
        <a href={siteConfig.releaseUrl} class="mt-6 inline-flex items-center justify-center gap-2 rounded-xl bg-stone-800 px-5 py-3 font-semibold text-orange-25 outline-none hover:bg-stone-700 focus-visible:ring-3 focus-visible:ring-rose-300" target="_blank" rel="noopener noreferrer"><DownloadIcon className="size-4" aria-hidden="true" />Get the latest release</a>
      </div>
      <div class="mx-auto max-w-xl space-y-5 text-left text-lg leading-relaxed text-stone-600">
        <p>Download the DMG from GitHub Releases, then move <strong class="font-medium text-stone-800">VibeHUD.app</strong> into Applications. Open Agent Hooks in the notch menu and enable the integration you use, then start a new agent session.</p>
        <p>Open your coding agent in a terminal to start a session. Use the notch menu to manage agent hooks, choose your display and notification sound, or enable Launch at Login.</p>
        <p>Already installed? Check for updates from the app’s notch menu.</p>
        <p>For setup and compatibility details, follow the <a class={uiClasses.contactLink} href="/docs/">setup guide</a>, visit the <a class={uiClasses.contactLink} href="/faqs/">FAQ page</a> or <a class={uiClasses.contactLink} href={siteConfig.supportUrl} target="_blank" rel="noopener noreferrer">get help on GitHub</a>.</p>
      </div>
      <a class="mt-8 inline-flex items-center gap-2 text-sm font-medium text-stone-500 hover:text-stone-800 focus-visible:ring-2 focus-visible:ring-rose-300" href={siteConfig.repositoryUrl} target="_blank" rel="noopener noreferrer"><CodeXml className="size-4" aria-hidden="true" />View source</a>
    </section>
  </main>
  <AppFooter />
</Layout>
