---
import Layout from './Layout.astro'
import AppHeader from '../components/AppHeader.astro'
import AppFooter from '../components/AppFooter.astro'
import { siteConfig } from '../config/site'
import { uiClasses } from '../config/ui'
import '../assets/css/main.css'

interface Props { title: string; description: string; updated: string }
const { title, description, updated } = Astro.props
const pageUrl = new URL(Astro.url.pathname, siteConfig.siteUrl).toString()
const structuredData = [
  {
    '@context': 'https://schema.org', '@type': 'TechArticle', '@id': `${pageUrl}#article`,
    headline: title, description, url: pageUrl, dateModified: updated,
    inLanguage: siteConfig.language,
    author: { '@id': `${siteConfig.siteUrl}/#organization` },
    about: { '@id': `${siteConfig.siteUrl}/#app` },
    isPartOf: { '@id': `${siteConfig.siteUrl}/#website` },
  },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteConfig.siteUrl}/` },
      { '@type': 'ListItem', position: 2, name: 'Docs', item: `${siteConfig.siteUrl}/docs/` },
      { '@type': 'ListItem', position: 3, name: title, item: pageUrl },
    ],
  },
]
---
<Layout title={`${title} | vibe hud`} description={description} type="article" structuredData={structuredData}>
  <AppHeader />
  <main class="mx-auto w-full max-w-4xl flex-1 px-8 pt-32 pb-16 sm:pt-44 sm:pb-24">
    <nav aria-label="Breadcrumb" class="mb-8 flex flex-wrap gap-3 text-sm text-stone-500"><a class={uiClasses.contactLink} href="/">Home</a><span aria-hidden="true">/</span><a class={uiClasses.contactLink} href="/docs/">Docs</a></nav>
    <article>
      <header><h1 class="text-4xl leading-tight font-bold tracking-tight sm:text-5xl">{title}</h1><p class="mt-5 text-xl leading-relaxed text-stone-600">{description}</p><p class="mt-4 text-sm text-stone-500">Updated <time datetime={updated}>{updated}</time></p></header>
      <div class="guide-content mt-10 text-base leading-relaxed text-stone-600 sm:text-lg"><slot /></div>
    </article>
    <nav aria-label="Related guides" class="mt-12 flex flex-wrap gap-x-6 gap-y-4 border-t border-orange-950/10 pt-7 text-sm"><a class={uiClasses.contactLink} href="/docs/">All setup guides</a><a class={uiClasses.contactLink} href="/docs/compatibility/">Agent and terminal compatibility</a><a class={uiClasses.contactLink} href="/faqs/">FAQs</a></nav>
  </main>
  <AppFooter />
</Layout>
<style is:global>
  .guide-content figure { margin: 2rem 0; }
  .guide-content figure img { display: block; width: 100%; height: auto; border-radius: 1rem; }
  .guide-content figcaption { margin-top: 0.75rem; font-size: 0.875rem; line-height: 1.5; color: var(--color-stone-500); }
  .guide-content h2 { margin-top: 2.5rem; margin-bottom: 1rem; font-size: 1.5rem; font-weight: 700; line-height: 1.3; color: var(--color-stone-800); scroll-margin-top: 9rem; }
  .guide-content h3 { margin-top: 1.75rem; margin-bottom: 0.75rem; font-size: 1.125rem; font-weight: 600; color: var(--color-stone-800); }
  .guide-content p, .guide-content ul, .guide-content ol, .guide-content table { margin-top: 1rem; margin-bottom: 1rem; }
  .guide-content ul { list-style: disc; padding-left: 1.5rem; }
  .guide-content ol { list-style: decimal; padding-left: 1.5rem; }
  .guide-content li + li { margin-top: 0.5rem; }
  .guide-content a { text-decoration: underline; text-underline-offset: 0.2em; text-decoration-color: var(--color-stone-400); }
  .guide-content a:hover { color: var(--color-stone-900); }
  .guide-content a:focus-visible { outline: 2px solid var(--color-rose-300); outline-offset: 3px; border-radius: 0.125rem; }
  .guide-content code { overflow-wrap: anywhere; border-radius: 0.25rem; background: color-mix(in srgb, var(--color-orange-950) 5%, transparent); font-size: 0.875em; }
  .guide-content table { display: block; width: 100%; overflow-x: auto; font-size: 0.875rem; }
  .guide-content th, .guide-content td { padding: 0.75rem; text-align: left; vertical-align: top; border-bottom: 1px solid var(--color-stone-300); }
  .guide-content th { color: var(--color-stone-800); font-weight: 600; }
</style>
